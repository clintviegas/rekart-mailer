# Application
NODE_ENV=development
PORT=8000
API_PREFIX=api/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/rekart-mailer

# Redis (for BullMQ sell-email worker when SELL_USE_BULL_QUEUE=true)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Journey step sends: true = queue + worker (needs Redis). false/unset = direct SMTP only
# and NO Bull/Redis connection is opened (no Redis error spam).
# SELL_USE_BULL_QUEUE=false


EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=shantanu@scalify.ae
SMTP_PASS=igsjqayhybifzrta
SMTP_FROM_EMAIL=shantanu@scalify.ae
SMTP_FROM_NAME=Rekart Team

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Crypto
BCRYPT_ROUNDS=12
RESET_TOKEN_EXPIRES_IN=3600

# Frontend
FRONTEND_URL=http://localhost:3000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
